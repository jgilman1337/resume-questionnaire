{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jgilman1337/resume-questionnaire/refs/heads/master/schemas/resume-questionnaire-export.schema.json",
  "title": "ResumeQuestionnaireExportV1",
  "description": "One job export. questions is required. schemaVersion is required when meta is present.",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "dependentRequired": {
    "meta": ["schemaVersion"]
  },
  "$defs": {
    "questionPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "questionsArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/questionPair"
      }
    },
    "projectRefs": {
      "type": "array",
      "description": "Optional. Links to separate project JSON files (paths relative to this job file).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable slug (e.g. refund-hardening); should match projectMeta.id in the linked file."
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path from this job JSON to the project fragment."
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experienceLabel": {
          "type": "string",
          "description": "e.g. Acme Corp — Senior Software Engineer"
        },
        "dateRange": {
          "type": "string",
          "description": "e.g. Jan 2022 – Present"
        },
        "location": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "questions": {
      "$ref": "#/$defs/questionsArray"
    },
    "projectRefs": {
      "$ref": "#/$defs/projectRefs"
    }
  }
}
